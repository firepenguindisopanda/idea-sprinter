# Base URL of the FastAPI backend.
#
# This is the name the code actually reads (src/lib/api.ts). It must be
# NEXT_PUBLIC_API_URL - this file previously documented NEXT_PUBLIC_SERVER_URL,
# which nothing reads, so following it left a deployed frontend silently
# calling http://localhost:5001.
#
# Baked in at build time by Next, so it must be set before `next build`,
# not only in the runtime environment.
NEXT_PUBLIC_API_URL=http://localhost:5001

BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true
